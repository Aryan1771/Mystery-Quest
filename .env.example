# Copy these values into Vercel Project Settings > Environment Variables.
# Never commit real credentials or paste the Turso token into source code.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app
TURSO_DB_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-database-token
